        "bitaboom": "^2.0.0",
        "cli-progress": "^3.12.0",
        "cli-welcome": "^3.0.1",
        "conf": "^14.0.0",
        "kokokor": "^2.0.4",
        "linkedom": "^0.18.12",
        "pino": "^9.9.5",
        "pino-pretty": "^13.1.1",
        "rabbito": "^1.0.0",
        "remove-markdown": "^0.6.2",
        "shamela": "^1.1.0",
        "string-strip-html": "^13.4.13",
        "tafrigh": "^4.0.2"
    },
    "description": "CLI for IlmTest API.",
    "devDependencies": {
        "@biomejs/biome": "^2.2.4",
